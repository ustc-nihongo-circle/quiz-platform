# Site-specific locations. Preserve the existing five-field access log.
limit_req_status 429;
# Existing error_log level is warn: do not add client-IP rate-limit error logs.
limit_req_log_level notice;
error_page 429 = @quiz_rate_limited;
error_page 413 = @quiz_request_too_large;
location @quiz_rate_limited {
    default_type application/json;
    add_header Retry-After 3 always;
    add_header Cache-Control no-store always;
    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Content-Type-Options nosniff always;
    return 429 '{"error":{"code":"rate_limited","message":"请求较频繁，请稍后重试。","field_errors":{},"retryable":true,"retry_after_seconds":3}}';
}
location @quiz_request_too_large {
    default_type application/json;
    add_header Cache-Control no-store always;
    return 413 '{"error":{"code":"request_too_large","message":"请求超过大小限制。","field_errors":{},"retryable":false}}';
}
location = / { return 302 /participant/; }
location /ops { return 404; }
location /admin { return 404; }
location = /favicon.ico { alias @STATIC_ROOT@/quiz/icons/favicon.ico; access_log off; }
location /static/ { alias @STATIC_ROOT@/; autoindex off; access_log off; }
location = /api/v1/participant-session {
    if ($request_method !~ ^(POST|DELETE)$) { return 405; }
    client_max_body_size 8k;
    limit_req zone=quiz_registration_ip burst=100 nodelay;
    limit_req zone=quiz_registration_site burst=200 nodelay;
    limit_req zone=quiz_exit_ip burst=50 nodelay;
    limit_req zone=quiz_exit_site burst=100 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location = /api/v1/attempts {
    if ($request_method !~ ^(POST)$) { return 405; }
    limit_req zone=quiz_start_ip burst=100 nodelay;
    limit_req zone=quiz_start_site burst=200 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location ~ "^/api/v1/attempts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/submission$" {
    if ($request_method !~ ^(PUT)$) { return 405; }
    limit_req zone=quiz_submit_ip burst=200 nodelay;
    limit_req zone=quiz_submit_site burst=400 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location = /participant/ {
    if ($request_method !~ ^(GET)$) { return 405; }
    limit_req zone=quiz_read_ip burst=1000 nodelay;
    limit_req zone=quiz_read_site burst=2000 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location = /api/v1/activity {
    if ($request_method !~ ^(GET)$) { return 405; }
    limit_req zone=quiz_read_ip burst=1000 nodelay;
    limit_req zone=quiz_read_site burst=2000 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location = /api/v1/attempts/current {
    if ($request_method !~ ^(GET)$) { return 405; }
    limit_req zone=quiz_read_ip burst=1000 nodelay;
    limit_req zone=quiz_read_site burst=2000 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location = /api/v1/attempts/history {
    if ($request_method !~ ^(GET)$) { return 405; }
    limit_req zone=quiz_read_ip burst=1000 nodelay;
    limit_req zone=quiz_read_site burst=2000 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location ~ "^/api/v1/attempts/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/items/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/image)?$" {
    if ($request_method !~ ^(GET)$) { return 405; }
    limit_req zone=quiz_read_ip burst=1000 nodelay;
    limit_req zone=quiz_read_site burst=2000 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location ~ "^/health/(live/|ready/)?$" {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    limit_req zone=quiz_health_ip burst=50 nodelay;
    limit_req zone=quiz_health_site burst=100 nodelay;
    include @SNIPPETS_ROOT@/quiz-proxy.conf;
}
location / { return 404; }
