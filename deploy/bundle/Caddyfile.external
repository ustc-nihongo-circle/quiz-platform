# Both listeners are bound to host loopback by quizctl's external-proxy mode.
# The existing Nginx must overwrite X-Forwarded-For with $remote_addr.
{$PUBLIC_SITE} {
    @private path /ops /ops/* /admin /admin/*
    handle @private {
        respond 404
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            header_up X-Real-IP {http.request.header.X-Real-IP}
        }
    }
}
{$ADMIN_SITE} {
    @wrong_origin {
        method POST PUT PATCH DELETE
        not header Origin {$ADMIN_ORIGIN}
    }
    respond @wrong_origin 403
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            header_up X-Real-IP {http.request.header.X-Real-IP}
        }
    }
}
