DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<generate-on-target>
DJANGO_ALLOWED_HOSTS=quiz.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://quiz.localhost:18443
DJANGO_USE_SQLITE=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_BEHIND_PROXY=1
DJANGO_TRUSTED_PROXY_COUNT=1
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

POSTGRES_DB=nihongo_quiz
POSTGRES_USER=nihongo_quiz
POSTGRES_PASSWORD=<generate-on-target>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

QUIZ_IDENTITY_KEYS={"v1":"<base64-encoded-32-byte-key>"}
QUIZ_IDENTITY_ACTIVE_KEY_ID=v1
QUIZ_IDENTITY_HMAC_KEY=<base64-encoded-32-byte-key>

# The local rehearsal copies backups off V: through this WSL mount.
QUIZ_SECONDARY_BACKUP_DIR=/mnt/e/Program-personal/Repository/ustc-nihongo-quiz/_private/deployment-local/backups
