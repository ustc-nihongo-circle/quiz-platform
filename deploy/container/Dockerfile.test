FROM quiz-platform:archive-2026
USER root
RUN python -m pip install --no-cache-dir pytest==9.1.1 pytest-django==4.14.0 ruff==0.16.4
COPY --chown=10001:10001 tests/ /app/tests/
COPY --chown=10001:10001 deploy/ /app/deploy/
COPY --chown=10001:10001 .gitattributes /app/.gitattributes
USER 10001:10001
CMD ["python", "-m", "pytest", "-q"]
