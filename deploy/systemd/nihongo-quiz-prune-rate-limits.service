[Unit]
Description=Prune idle quiz admission-control buckets
After=postgresql.service

[Service]
Type=oneshot
User=nihongo-quiz
Group=nihongo-quiz
EnvironmentFile=/srv/nihongo-quiz/shared/env/production.env
Environment=PYTHONPATH=/srv/nihongo-quiz/current/src
WorkingDirectory=/srv/nihongo-quiz/current
ExecStart=/srv/nihongo-quiz/current/.venv/bin/python manage.py prune_rate_limit_buckets
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
