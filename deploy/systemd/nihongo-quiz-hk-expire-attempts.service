[Unit]
Description=Expire abandoned quiz answer sessions after 30 minutes (Docker)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/nihongo-quiz-hk
ExecStart=/usr/bin/docker compose exec -T --interactive=false web python manage.py expire_stale_attempts
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
