[Unit]
Description=Expire abandoned quiz answer sessions after 30 minutes
After=postgresql.service

[Service]
Type=oneshot
User=nihongo-quiz
Group=nihongo-quiz
UMask=0077
WorkingDirectory=/srv/nihongo-quiz/current
Environment=PYTHONPATH=/srv/nihongo-quiz/current/src
EnvironmentFile=/srv/nihongo-quiz/shared/env/production.env
ExecStart=/srv/nihongo-quiz/current/.venv/bin/python manage.py expire_stale_attempts
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
