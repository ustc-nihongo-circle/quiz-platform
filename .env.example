DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_USE_SQLITE=1

POSTGRES_DB=nihongo_quiz
POSTGRES_USER=nihongo_quiz
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Base64-encoded 32-byte values. Keep production values outside the repository.
QUIZ_IDENTITY_KEYS={"v1":"replace-with-base64-32-byte-key"}
QUIZ_IDENTITY_ACTIVE_KEY_ID=v1
QUIZ_IDENTITY_HMAC_KEY=replace-with-base64-32-byte-key

# Production only. Start at 0 until HTTPS and proxy headers are verified.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_BEHIND_PROXY=0
DJANGO_TRUSTED_PROXY_COUNT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
